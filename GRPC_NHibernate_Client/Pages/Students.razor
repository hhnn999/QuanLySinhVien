@page "/students"
@inherits StudentsBase

<div class="container mt-4">

    <h2 class="text-primary fw-bold mb-4">📘 Quản lý sinh viên</h2>

    <!-- Form thêm/sửa -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white fw-bold">
            @(editingStudent == null ? "Thêm sinh viên" : $"Sửa sinh viên: {editingStudent.FullName}")
        </div>

        <div class="card-body row g-3">
            <div class="col-md-3">
                <label class="form-label">Mã SV</label>
                <input class="form-control" @bind="code" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Họ tên</label>
                <input class="form-control" @bind="fullName" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Địa chỉ</label>
                <input class="form-control" @bind="address" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Ngày sinh</label>
                <input class="form-control" type="date" @bind="birthDate" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Lớp học</label>
                <select class="form-select" @bind="selectedClassRoomId">
                    <option value="0">— Chọn lớp —</option>
                    @foreach (var c in classRooms)
                    {
                        <option value="@c.Id">@($"{c.Code} — {c.Name}")</option>
                    }
                </select>
            </div>

            <div class="col-12 text-end">
                @if (editingStudent != null)
                {
                    <button class="btn btn-secondary me-2" @onclick="CancelEdit">Hủy</button>
                }
                <button class="btn btn-success" @onclick="SaveStudent">Lưu</button>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white fw-bold">Danh sách sinh viên</div>

        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Mã SV</th>
                        <th>Họ tên</th>
                        <th>Địa chỉ</th>
                        <th>Ngày sinh</th>
                        <th>Lớp</th>
                        <th>Môn</th>
                        <th>Giáo viên</th>
                        <th>Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var s in students)
                    {
                        <tr>
                            <td>@s.Id</td>
                            <td>@s.Code</td>
                            <td>@s.FullName</td>
                            <td>@s.Address</td>
                            <td>@s.BirthDate?.ToString("dd/MM/yyyy")</td>
                            <td>@s.ClassRoom?.Name </td>
                            <td>@s.ClassRoom?.Subject</td>
                            <td>@s.ClassRoom?.Teacher?.FullName </td>
                            <td>
                                <button class="btn btn-sm btn-info text-white me-2" @onclick="() => EditStudent(s)">Sửa</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteStudent(s.Id)">Xóa</button>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>
